---
export interface Props {
  title: string;
  body?: string;
}

const { title, body } = Astro.props;
---

<div style="padding: var(--space-8); border: 1px dashed var(--color-border); border-radius: var(--radius-md);">
  <h3>{title}</h3>
  {body && <p style="color: var(--color-muted);">{body}</p>}
</div>

