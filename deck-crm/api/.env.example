APP_NAME="Deck API"
APP_ENV="production"
PORT="8080"

# Browser/frontend origins allowed to call the API.
ALLOWED_ORIGINS="https://deck.aistack.codes,https://www.deck.aistack.codes"
CORS_ORIGIN="https://deck.aistack.codes"

# Railway custom service domain configured in Railway DNS/settings:
# https://api.deck.aistack.codes

# Database
DATABASE_URL=""

# Auth
AUTH_SECRET_KEY=""
AUTH_SECRET_KEY_ID="prod-auth-v1"
AUTH_TOKEN_EXPIRY_MINUTES="60"
# Required for public investor/test-user account creation.
# Set false only for invite-only deployments.
PUBLIC_SIGNUP_ENABLED="true"
# Optional one-time admin bootstrap. Set a long random value in Railway,
# call POST /api/admin/users/bootstrap-role, then rotate/remove it.
USER_ADMIN_BOOTSTRAP_TOKEN=""

# Workspace AI provider key encryption.
WORKSPACE_AI_FERNET_KEY=""
WORKSPACE_AI_FERNET_KEY_VERSION="prod-fernet-v1"

# Upload/artifact storage. Use durable S3-compatible storage in production.
DECK_AISTACK_STORAGE_PROVIDER="s3"
UPLOADS_ROOT="/tmp/deck_uploads"

# Optional Supabase Storage mode. Do not expose these values to the frontend.
# DECK_AISTACK_STORAGE_PROVIDER="supabase"
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="deck-aistack-user-artifacts"
# DECK_AISTACK_SIGNED_URL_TTL_SECONDS="900"

# Railway bucket connector variables used by production:
# Bucket: dddecks-uploads (UUID: a116a287-53e4-44ba-8fb4-eb5d6df1a34f)
# Connect the backend service to this bucket using Railway's "AWS SDK (Generic)" style.
# Railway injects AWS_* variables into the service when the connector is attached.
# AWS_ENDPOINT_URL=""
# AWS_S3_BUCKET_NAME=""
# AWS_DEFAULT_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
MAX_REQUEST_BODY_SIZE_BYTES="220200960"
UPLOAD_SECURITY_SCAN_COMMAND=""
UPLOAD_SECURITY_SCAN_TIMEOUT_SECONDS="30"

# AI providers
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"
OPENAI_TIMEOUT_SECONDS="60"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o"
OPENROUTER_TIMEOUT_SECONDS="60"
OPENROUTER_SITE_URL="https://deck.aistack.codes"
OPENROUTER_APP_NAME="deck.aistack.codes"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
ANTHROPIC_MAX_TOKENS="4096"
ANTHROPIC_TIMEOUT_SECONDS="60"
ANTHROPIC_MAX_RETRIES="1"
ANTHROPIC_RETRY_DELAY_SECONDS="0.25"
SUPERADMIN_AISTACK_URL=""
SUPERADMIN_AISTACK_TIMEOUT_SECONDS="2.5"
DECK_KNOWLEDGE_INDEX_PATH="/app/backend/llm_knowledge/deck_archetype_knowledge/compiled_json/archetypes.index.json"
# Supported: claude, openai, openrouter. Production tester onboarding uses the product-owned OpenRouter key first.
DECK_GENERATION_MODE="openrouter"
AI_DAILY_GENERATION_QUOTA="50"

# Bot protection
TURNSTILE_SECRET_KEY=""
# Public interest CAPTCHA is opt-in until the frontend widget is configured.
# Leave false to avoid blocking the public lead form when no browser token is sent.
PUBLIC_INTEREST_TURNSTILE_REQUIRED="false"

# Railway sets this automatically; leave blank locally.
RAILWAY_ENVIRONMENT=""
