FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_ROLE=worker-llm-parallelization \
    DECK_WORKER_JOB_TYPES=llm_parallelization \
    PYSPARK_PYTHON=python3 \
    PYSPARK_DRIVER_PYTHON=python3 \
    SPARK_LOCAL_IP=127.0.0.1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-pyspark.txt requirements.txt ./
RUN pip install --upgrade pip \
    && pip install -r requirements-pyspark.txt

COPY . ./

CMD ["python", "scripts/deck_processing_worker.py"]
